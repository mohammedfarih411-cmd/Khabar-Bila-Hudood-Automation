############################################
# Google Gemini
############################################
GEMINI_API_KEY=your_gemini_api_key

############################################
# ElevenLabs Arabic narration
############################################
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_arabic_voice_id

############################################
# YouTube OAuth
############################################
# Local runs use the gitignored token.json file.
# Hosted runs may store the complete token.json contents in this secret.
YOUTUBE_TOKEN_JSON=

############################################
# Production safety
############################################
# Enable production in config.yaml only after all secrets are configured.
# YouTube remains private by default.

############################################
# Optional local overrides / documentation
############################################
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
OUTPUT_FOLDER=output
DATABASE_PATH=data/news.db
LOG_LEVEL=INFO
CHECK_INTERVAL_MINUTES=30
AI_MODEL=gemini-2.5-pro
YOUTUBE_PRIVACY=private
